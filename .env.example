# ─────────────────────────────────────────────────────────────────────────────
# Raven's Business Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# On Railway: set these in the Railway dashboard → Variables tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (REQUIRED) ────────────────────────────────────────────────

# Your login username (default: raven)
AUTH_USERNAME=raven

# Your login password (plain text — used if AUTH_PASSWORD_HASH is not set)
AUTH_PASSWORD=Lovelyn#1452!

# NextAuth secret — generate one with: openssl rand -base64 32
# REQUIRED in production, or logins will fail
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Your app's public URL (required in production)
# Example: https://ravens-business-hub.up.railway.app
NEXTAUTH_URL=http://localhost:3000

# ── AI Provider (pick ONE — Gemini is free, no credit card needed) ───────────

# OPTION 1 (Recommended — FREE):
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTION 2 (Pay-as-you-go, ~$1-5/month for light use):
# Get your key at https://console.anthropic.com
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# If neither AI key is set, AI features show a setup prompt — app still works.
# ─────────────────────────────────────────────────────────────────────────────
