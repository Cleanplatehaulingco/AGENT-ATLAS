# ─────────────────────────────────────────────────────────────────────────────
# Raven's Business Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider (pick ONE — Gemini is free, no credit card needed) ───────────

# OPTION 1 (Recommended — FREE):
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTION 2 (Pay-as-you-go, ~$1-5/month for light use):
# Get your key at https://console.anthropic.com
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# If neither key is set, the app still works — AI features show a setup prompt.
# ─────────────────────────────────────────────────────────────────────────────
