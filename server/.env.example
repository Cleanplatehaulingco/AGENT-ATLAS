# Etsy App credentials (from Etsy Developer Portal → your app)
ETSY_CLIENT_ID=your_etsy_keystring_here
ETSY_SHOP_ID=your_numeric_shop_id_here

# Server URL (your Render app URL — set this in Render env vars)
APP_URL=https://agent-atlas-api.onrender.com

# Frontend URL (do not change)
FRONTEND_URL=https://cleanplatehaulingco.github.io

# Port (Render sets this automatically)
PORT=3000
